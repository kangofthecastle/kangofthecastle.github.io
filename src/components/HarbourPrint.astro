---
type Props = { compact?: boolean };
const { compact = false } = Astro.props;
---
<figure class:list={['harbour-print', { 'harbour-print--compact': compact }]} data-harbour>
  <svg viewBox="0 0 760 650" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="windows" width="12" height="16" patternUnits="userSpaceOnUse"><path d="M3 4h3v6H3z" fill="#e5d9bd" opacity=".6"/></pattern>
      <pattern id="water-lines" width="120" height="24" patternUnits="userSpaceOnUse"><path d="M0 9h48m12 0h15m12 0h33M18 21h28m15 0h52" stroke="#ece6d7" stroke-width="1" opacity=".3"/></pattern>
      <clipPath id="harbour-crop"><path d="M0 0h760v650H0z"/></clipPath>
    </defs>
    <g clip-path="url(#harbour-crop)">
      <path fill="#e5deca" d="M0 0h760v650H0z"/>
      <g class="harbour-sun"><circle cx="565" cy="177" r="99" fill="#af4d38"/><circle cx="565" cy="177" r="112" stroke="#af4d38" stroke-width=".7"/></g>
      <path d="M0 96h230m360 216h170M0 143h120m20 0h70" stroke="#b6ac96" stroke-width="1"/>
      <g class="harbour-ranges">
        <path d="m-30 410 78-90 43 19 74-135 42 26 59 72 50-17 36-48 63 71 35-38 69-121 37 38 29-11 73 110 38-24 57 34 63 145H-30Z" fill="#9fa9a5"/>
        <path d="m120 310 45-106 42 26 31 38-43-18-23 2-14 30Z" fill="#ede6d5"/>
        <path d="m483 248 36-99 37 38 29-11 27 41-41-12-24 9-20-17Z" fill="#ede6d5"/>
        <path d="m-30 451 95-97 71 41 34-44 28 11 48-28 30 37 30-12 45-19 76 78 44-56 42-15 36 15 37-38 36 67 71-5 102 81H-30Z" fill="#536966"/>
        <path d="m0 427 70-48 61 55 43-28 44 17 34-14 52 56 43-25 76 10 54-38 60 12 66-27 41 60 116-28v89H0Z" fill="#2b4144"/>
      </g>
      <g class="harbour-city" fill="#27383e">
        <path d="M253 466v-64h30v64m5 0V369h23v97m7 0v-47h41v47m9 0V351h22v115m5 0v-80h33v80m10 0v-44h45v44m9 0v-95h24v95m7 0v-66h28v66m5 0v-39h45v39m9 0v-78h29v78"/>
        <path d="M375 351v-16m130 36v-15" stroke="#27383e" stroke-width="2"/>
        <path d="M253 466v-64h30v64m5 0V369h23v97m7 0v-47h41v47m9 0V351h22v115m5 0v-80h33v80m10 0v-44h45v44m9 0v-95h24v95m7 0v-66h28v66m5 0v-39h45v39m9 0v-78h29v78" fill="url(#windows)"/>
        <path d="m60 464 24-32 21 32m4 0 25-39 29 39m6 0 24-24 28 24" fill="#e5deca" stroke="#27383e" stroke-width="2"/>
        <path d="M0 468h760" stroke="#27383e" stroke-width="10"/>
      </g>
      <path d="M0 473h760v177H0z" fill="#6d8a83"/>
      <path d="M0 473h760v177H0z" fill="url(#water-lines)"/>
      <path d="M0 569c135-22 260 28 416 0s211-12 344-2M0 598c115-10 249 17 374-1s274-16 386 0" stroke="#b8c5b6" opacity=".55"/>
      <g class="harbour-boat">
        <path d="M124 550h173l-18 21H146z" fill="#27383e"/>
        <path d="M144 528h111l25 22H132z" fill="#eee7d7"/>
        <path d="M152 534h13v11h-13zm19 0h13v11h-13zm19 0h13v11h-13zm19 0h13v11h-13zm19 0h13v11h-13z" fill="#536966"/>
