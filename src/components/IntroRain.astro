<div class="intro-rain" data-intro-rain hidden aria-hidden="true">
  {Array.from({ length: 36 }, (_, i) => (
    <svg class="intro-rain__drop" viewBox="0 0 6 30" fill="none"
      style={`--rain-x:${((i * .61803398875) % 1) * 108}%;--rain-delay:${(i % 9) * .06}s;--rain-duration:${1.15 + (i % 4) * .08}s;--rain-size:${20 + (i % 3) * 5}px`}>
      <path d="M3 1C2 9 0 24 3 28C6 24 4 9 3 1Z" />
    </svg>
  ))}
</div>

<style>
  .intro-rain { position:absolute;inset:0;z-index:2;overflow:hidden;pointer-events:none; }
  .intro-rain[hidden] { display:none; }
  .intro-rain__drop {
    position:absolute;left:var(--rain-x);top:-40px;width:6px;height:var(--rain-size);
    stroke:var(--red);stroke-width:.8;stroke-linecap:round;opacity:0;
    animation:intro-rain-fall var(--rain-duration) linear var(--rain-delay) both;
  }
  @keyframes intro-rain-fall {
    0% { transform:translate(0,0) rotate(8deg);opacity:0; }
    8% { opacity:.85; }
    78% { opacity:.85; }
    100% { transform:translate(-8vw,var(--rain-travel,calc(100dvh + 80px))) rotate(8deg);opacity:0; }
  }
  @media(prefers-reduced-motion:reduce) { .intro-rain { display:none; } }
</style>

<script>
  const rain = document.querySelector<HTMLElement>('[data-intro-rain]');
  const opening = rain?.closest<HTMLElement>('.home-opening');
  if (rain && opening) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let firstShower = true;
    try { firstShower = sessionStorage.getItem('intro-rain-seen') !== '1'; }
    catch { /* Rain also works when browser storage is unavailable. */ }
    let visible = false;
    let remaining = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const enabled = () => visible && !document.hidden && !reducedMotion.matches;
    const cancelTimer = () => { clearTimeout(timer); timer = undefined; };
    const schedule = () => {
      cancelTimer();
      if (enabled()) timer = setTimeout(play, 30_000);
    };
    const play = () => {
      cancelTimer();
      if (!enabled()) return;
      rain.style.setProperty('--rain-travel', `${opening.clientHeight + 80}px`);
      remaining = rain.children.length;
      rain.hidden = false;
      firstShower = false;
      try { sessionStorage.setItem('intro-rain-seen', '1'); }
      catch { /* No storage is needed for subsequent showers. */ }
    };
    const reconcile = () => {
      if (!enabled()) {
        cancelTimer();
        rain.hidden = true;
        remaining = 0;
      } else if (rain.hidden) {
        if (firstShower) play();
        else schedule();
      }
    };
    rain.addEventListener('animationend', () => {
      if (rain.hidden || --remaining > 0) return;
      rain.hidden = true;
      schedule();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && entry.intersectionRatio >= .15;
      reconcile();
    }, { threshold: [.15] }).observe(opening);
    document.addEventListener('visibilitychange', reconcile);
    reducedMotion.addEventListener('change', reconcile);
  }
</script>
