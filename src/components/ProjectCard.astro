---
import type { Project } from '@/data/projects';

type Props = { project: Project };
const { project } = Astro.props;
---

<article class={`project-card project-card--${project.accent}`}>
  <a class="project-card__media" href={`/projects/${project.slug}/`}>
    <img src={project.media} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{project.eyebrow}</span>
      <span>{project.year}</span>
    </div>
    <h2><a href={`/projects/${project.slug}/`}>{project.title}</a></h2>
    <p>{project.summary}</p>
    <ul aria-label="Project disciplines">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>
