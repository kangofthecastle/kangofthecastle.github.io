---
type Props = {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
};

const { index, eyebrow, title, description } = Astro.props;
---

<header class="section-heading">
  <div class="section-heading__index">{index}</div>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>
</header>
