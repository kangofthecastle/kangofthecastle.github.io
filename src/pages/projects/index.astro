---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Projects — Warren"
  description="Games, learning systems, local-first tools, and personal software built in Vancouver."
  pageClass="inner-page projects-page"
>
  <header class="page-hero page-hero--projects">
    <p class="eyebrow">Projects</p>
    <h1>The project<br /><em>collection.</em></h1>
    <p>Games, study software, and little things that make a computer more personal. Pick one to look inside.</p>
  </header>

  <div class="collection-label section-shell"><span>All projects / {String(projects.length).padStart(2, '0')}</span><span>Made by Warren · 2026</span></div>

  <section class="project-index section-shell" aria-label="All projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>
