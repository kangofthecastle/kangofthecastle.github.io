---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Projects — Warren"
  description="Games, learning systems, local-first tools, and personal software built in Vancouver."
  pageClass="inner-page"
>
  <header class="page-hero page-hero--projects">
    <p class="eyebrow">Projects</p>
    <h1>Games, study software,<br /><em>and small tools.</em></h1>
    <p>This is the current list. Each page explains why I made the project, what it currently does, what is unfinished, and which parts can be shown publicly.</p>
  </header>

  <section class="project-index section-shell" aria-label="All projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>
