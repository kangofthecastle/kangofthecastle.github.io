---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, type Project } from '@/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = { project: Project };
const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} — Warren`}
  description={project.summary}
  image={project.media}
  pageClass={`inner-page project-page project-page--${project.accent}`}
>
  <header class="project-hero">
    <div class="project-hero__meta">
      <span>{project.year}</span>
      <span>{project.visibility === 'private' ? 'Private repository' : project.visibility}</span>
    </div>
    <p class="eyebrow">{project.eyebrow}</p>
    <h1>{project.title}</h1>
    <p class="project-hero__summary">{project.summary}</p>
    {project.repository && (
      <a class="project-repository" href={project.repository} target="_blank" rel="noreferrer" aria-label={`${project.title} on GitHub`}>
        GitHub <span aria-hidden="true">↗</span>
      </a>
    )}
  </header>

  <figure class="project-lead-media">
    <img src={project.media} alt={project.mediaAlt} width="1600" height="1000" />
    <figcaption>
      <span>{project.mediaCaption}</span>
    </figcaption>
  </figure>

  {project.captures && project.captures.length > 0 && (
    <section class="project-captures section-shell" aria-labelledby="capture-heading">
      <header>
        <h2 id="capture-heading">Screens from<br />the project.</h2>
      </header>
      <div class="project-captures__grid">
        {project.captures.map((capture) => (
          <figure>
            <img src={capture.src} alt={capture.alt} width="900" height="1400" loading="lazy" />
            <figcaption>
              <span>{capture.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <div class="project-story section-shell">
    <aside>
      <p class="eyebrow">Stack</p>
      <ul>
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>
      <p class="eyebrow">Signals</p>
      <ul>
        {project.tags.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
    <div class="project-story__chapters">
      <section>
        <h2>Why I made it</h2>
        <p>{project.problem}</p>
      </section>
      <section>
        <h2>How it works</h2>
        <p>{project.solution}</p>
      </section>
      <section>
        <h2>Where it is now</h2>
        <p>{project.outcome}</p>
      </section>
    </div>
  </div>

  <nav class="project-next" aria-label="Project navigation">
    <span>Keep looking</span>
    <a href="/projects/">Back to projects <span aria-hidden="true">↗</span></a>
  </nav>
</BaseLayout>
