---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, type Project } from '@/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = { project: Project };
const { project } = Astro.props;
const nextProject = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
---

<BaseLayout
  title={`${project.title} — Warren`}
  description={project.summary}
  image={project.media}
  pageClass={`inner-page project-page project-page--${project.accent}`}
>
  <header class="project-hero">
    <a class="project-back" href="/projects/">← The collection</a>
    <div class="project-hero__meta">
      <span>{project.year}</span>
      <span>{project.visibility === 'private' ? 'Private repository' : project.visibility}</span>
    </div>
    <p class="eyebrow">{project.eyebrow}</p>
    <h1>{project.title}</h1>
    <p class="project-hero__summary">{project.summary}</p>
  </header>

  <figure class="project-lead-media">
    <img src={project.media} alt={project.mediaAlt} width="1600" height="1000" />
    <figcaption>
      <span>{project.mediaCaption}</span>
    </figcaption>
  </figure>

  {project.captures && project.captures.length > 0 && (
    <section class="project-captures section-shell" aria-labelledby="capture-heading">
      <header>
        <p class="eyebrow">In use</p>
        <h2 id="capture-heading">Screens from<br />the project.</h2>
      </header>
      <div class="project-captures__grid">
        {project.captures.map((capture) => (
          <figure>
            <img src={capture.src} alt={capture.alt} width="900" height="1400" loading="lazy" />
            <figcaption>
              <span>{capture.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <div class="project-story section-shell">
    <aside>
      <nav class="story-nav" aria-label="On this page"><p class="eyebrow">On this page</p><a href="#why">01 / What I wanted</a><a href="#how">02 / How it works</a><a href="#now">03 / Where it is now</a></nav>
      <p class="eyebrow">Built with</p>
      <ul>
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>
      <p class="eyebrow">Areas</p>
      <ul>
        {project.tags.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
    <div class="project-story__chapters">
      <section id="why">
        <p class="eyebrow">01 / Why I made it</p>
        <h2>What I wanted</h2>
        <p>{project.problem}</p>
      </section>
      <section id="how">
        <p class="eyebrow">02 / What it does</p>
        <h2>How it works</h2>
        <p>{project.solution}</p>
      </section>
      <section id="now">
        <p class="eyebrow">03 / Current state</p>
        <h2>Where it is now</h2>
        <p>{project.outcome}</p>
      </section>
    </div>
  </div>

  <nav class="project-next" aria-label="Project navigation">
    <span>Next in the collection</span>
    <a href={`/projects/${nextProject.slug}/`}>{nextProject.title} <span aria-hidden="true">↗</span></a>
  </nav>
</BaseLayout>
