---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout pageClass="home-page home-page--poster">
  <section class="poster-hero" data-poster-hero>
    <div class="poster-hero__sticky">
        <div class="poster-scene" data-poster-scene aria-hidden="true">
        <div class="poster-sun" data-poster-sun></div>
        <div class="poster-mountain poster-mountain--far" data-mountain-far></div>
        <div class="poster-mountain poster-mountain--near" data-mountain-near></div>

        <div class="poster-city" data-poster-city>
          <span class="poster-building poster-building--low" style="--x: 0%; --w: 12%; --h: 35%;"></span>
          <span class="poster-building poster-building--tower" style="--x: 15%; --w: 8%; --h: 68%;"></span>
          <span class="poster-building" style="--x: 27%; --w: 15%; --h: 48%;"></span>
          <span class="poster-building poster-building--slim" style="--x: 46%; --w: 7%; --h: 78%;"></span>
          <span class="poster-building poster-building--saw" style="--x: 57%; --w: 17%; --h: 42%;"></span>
          <span class="poster-building poster-building--tower" style="--x: 78%; --w: 8%; --h: 58%;"></span>
          <span class="poster-building poster-building--low" style="--x: 89%; --w: 11%; --h: 31%;"></span>
        </div>

        <div class="poster-crane" data-poster-crane>
          <span class="poster-crane__leg poster-crane__leg--left"></span>
          <span class="poster-crane__leg poster-crane__leg--right"></span>
          <span class="poster-crane__boom"></span>
          <span class="poster-crane__trolley"></span>
          <span class="poster-crane__cable"></span>
          <span class="poster-crane__hook"></span>
        </div>

        <div class="poster-water" data-poster-water></div>
        <div class="poster-seabus" data-poster-seabus>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="poster-halftone"></div>
      </div>

      <div class="poster-copy" data-poster-copy>
        <p class="poster-kicker">Warren · software developer · Vancouver</p>
        <h1>
          <span>Software</span>
          <span>for problems</span>
          <span>I actually have.</span>
        </h1>
        <p>
          I make games, study software, and small desktop tools—usually because I
          want a version that does something existing software does not.
        </p>
      </div>

      <div class="poster-stamp" data-poster-stamp aria-hidden="true">
        Built in<br />Vancouver
      </div>

      <div class="poster-aperture" data-poster-aperture>
        <p>HUBRIS / Goldwake</p>
        <figure>
          <img src="/images/projects/goldwake-title.webp" alt="The HUBRIS title screen" />
        </figure>
        <span>Portrait bullet-hell · WebGL2</span>
      </div>
    </div>
  </section>

  <section class="print-film" data-print-film aria-label="Selected projects">
    <div class="print-film__sticky">
      <div class="print-film__ink" data-film-ink aria-hidden="true"></div>
      <p class="print-film__label">Projects, shown working</p>

      <article class="print-chapter print-chapter--goldwake" data-print-chapter data-ink="#172338">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">HUBRIS / Goldwake</p>
          <h2>A portrait bullet-hell where grazing charges the screen clear.</h2>
          <p>
            Grazing fills an Apotheosis gauge. Triggering it cancels every enemy
            bullet into collectible gold. The run seed also chooses the encounters
            and procedural score.
          </p>
          <p class="print-chapter__meta">WebGL2 · Canvas · WebAudio · JavaScript · playable locally</p>
          <a href="/projects/goldwake/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="project-motion project-motion--goldwake" data-goldwake-scene>
          <img class="goldwake-depth" data-goldwake-depth src="/images/projects/cinematic/goldwake-deep.webp" alt="" />
          <img class="goldwake-structure" data-goldwake-structure src="/images/projects/cinematic/goldwake-structure.webp" alt="" />
          <div class="goldwake-screen" data-goldwake-screen>
            <img src="/images/projects/goldwake-title.webp" alt="The HUBRIS title screen" />
          </div>
          <img class="goldwake-debris" data-goldwake-debris src="/images/projects/cinematic/goldwake-debris.webp" alt="" />
          <div class="goldwake-bullets" data-goldwake-bullets aria-hidden="true">
            <i style="--x: 13%; --y: 19%; --tx: 39%; --ty: 42%;"></i>
            <i style="--x: 28%; --y: 8%; --tx: 46%; --ty: 36%;"></i>
            <i style="--x: 48%; --y: 13%; --tx: 51%; --ty: 38%;"></i>
            <i style="--x: 73%; --y: 7%; --tx: 57%; --ty: 39%;"></i>
            <i style="--x: 88%; --y: 22%; --tx: 62%; --ty: 44%;"></i>
            <i style="--x: 94%; --y: 49%; --tx: 64%; --ty: 50%;"></i>
            <i style="--x: 84%; --y: 75%; --tx: 60%; --ty: 57%;"></i>
            <i style="--x: 65%; --y: 91%; --tx: 55%; --ty: 61%;"></i>
            <i style="--x: 36%; --y: 88%; --tx: 46%; --ty: 60%;"></i>
            <i style="--x: 11%; --y: 72%; --tx: 38%; --ty: 56%;"></i>
            <i style="--x: 5%; --y: 45%; --tx: 36%; --ty: 49%;"></i>
          </div>
          <div class="goldwake-wave" data-goldwake-wave aria-hidden="true"></div>
          <div class="goldwake-coins" data-goldwake-coins aria-hidden="true">
            <i style="--angle: -72deg; --distance: 9rem;"></i>
            <i style="--angle: -36deg; --distance: 12rem;"></i>
            <i style="--angle: 2deg; --distance: 10rem;"></i>
            <i style="--angle: 46deg; --distance: 13rem;"></i>
            <i style="--angle: 88deg; --distance: 9rem;"></i>
            <i style="--angle: 137deg; --distance: 12rem;"></i>
            <i style="--angle: 184deg; --distance: 10rem;"></i>
            <i style="--angle: 228deg; --distance: 13rem;"></i>
          </div>
          <figcaption>Bullets close in. Apotheosis cancels them into gold.</figcaption>
        </figure>
      </article>

      <article class="print-chapter print-chapter--agame" data-print-chapter data-ink="#3154a6">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">A-Game</p>
          <h2>A birthday game built for one person and one sitting.</h2>
          <p>
            You visit two friends, play games inside their computers, and bring three
            keepsakes home when a violin starts calling. The keepsakes become a lit
            paper boat before the water turns into a galaxy.
          </p>
          <p class="print-chapter__meta">Phaser · TypeScript · Electron · no fail states</p>
          <a href="/projects/a-game/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="project-motion project-motion--agame" data-agame-scene>
          <div class="agame-panel agame-panel--outside" data-agame-outside>
            <img src="/images/projects/a-game-outside.webp" alt="The village outside the player’s house in A-Game" />
          </div>
          <div class="agame-panel agame-panel--clearing" data-agame-clearing>
            <img src="/images/projects/a-game-clearing.webp" alt="The lantern-lit clearing near the end of A-Game" />
          </div>
          <div class="agame-panel agame-panel--galaxy" data-agame-galaxy>
            <img src="/images/projects/cinematic/a-game-galaxy.webp" alt="The water-to-galaxy transition from A-Game’s ending" />
          </div>
          <div class="agame-keepsakes" data-agame-keepsakes aria-hidden="true">
            <img src="/images/projects/a-game-assets/keepsake-golden-hour-photo.png" alt="" />
            <img src="/images/projects/a-game-assets/keepsake-glowing-koi-scale.png" alt="" />
            <img src="/images/projects/a-game-assets/keepsake-defused-spike-charm.png" alt="" />
          </div>
          <img class="agame-boat" data-agame-boat src="/images/projects/a-game-assets/alice-boat.png" alt="Alice travelling in the paper boat" />
          <div class="agame-stars" data-agame-stars aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
          <figcaption>Village, clearing, paper boat, then the water becomes a galaxy.</figcaption>
        </figure>
      </article>

      <article class="print-chapter print-chapter--freecat" data-print-chapter data-ink="#79b9a5">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">FreeCAT</p>
          <h2>Local-first MCAT study software in one SQLite file.</h2>
          <p>
            The question bank, lessons, imported Anki decks, review history, XP, and
            study pet all stay on the learner’s computer. No account and no hosted
            progress database.
          </p>
          <p class="print-chapter__meta">Electron · React · TypeScript · SQLite · in development</p>
          <a href="/projects/freecat/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="project-motion project-motion--freecat" data-freecat-scene>
          <div class="freecat-database" data-freecat-database aria-hidden="true">
            <span>FREECAT.DB</span>
            <i></i>
            <small>one local file</small>
          </div>
          <div class="freecat-window freecat-window--home" data-freecat-window="home">
            <span>Home / study pet</span>
            <img src="/images/projects/freecat-home.webp" alt="FreeCAT running locally with a study pet and progress summary" />
          </div>
          <div class="freecat-window freecat-window--qbank" data-freecat-window="qbank">
            <span>Question bank</span>
            <img src="/images/projects/freecat-qbank.webp" alt="FreeCAT question-bank practice setup" />
          </div>
          <div class="freecat-window freecat-window--content" data-freecat-window="content">
            <span>Content review</span>
            <img src="/images/projects/freecat-content.webp" alt="FreeCAT content-review topic list" />
          </div>
          <div class="freecat-route" data-freecat-route aria-hidden="true"><i></i><i></i><i></i></div>
          <figcaption>Three working surfaces. The data underneath them never leaves the machine.</figcaption>
        </figure>
      </article>

      <article class="print-chapter print-chapter--toybox" data-print-chapter data-ink="#e5aa2d">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">Toybox</p>
          <h2>Small Windows utilities written in Python’s standard library.</h2>
          <p>
            Toybox combines a system HUD, an in-memory clipboard that syncs text to
            my Mac over the local network, and a pixel cat that dances to music, runs
            timers, naps in a box, and carries dropped files.
          </p>
          <p class="print-chapter__meta">Python · Tkinter · Win32 APIs · no telemetry</p>
          <a href="/projects/toybox/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="project-motion project-motion--toybox" data-toybox-scene>
          <img class="toybox-proof" src="/images/projects/toybox-staged.webp" alt="A sanitized Toybox staging using the real desktop cat sprite" />
          <div class="toybox-window toybox-window--system" data-toybox-window="system">
            <span>System monitor</span>
            <strong>CPU 18%</strong>
            <small>RAM 7.9 / 32 GB<br />Now playing · local audio</small>
          </div>
          <div class="toybox-window toybox-window--timer" data-toybox-window="timer">
            <span>Focus timer</span>
            <strong class="toybox-timer__time toybox-timer__time--one">24:18</strong>
            <strong class="toybox-timer__time toybox-timer__time--two" data-toybox-time>12:06</strong>
            <small>Cat stays above the timer</small>
          </div>
          <div class="toybox-window toybox-window--clipboard" data-toybox-window="clipboard">
            <span>Clipboard · memory only</span>
            <small>Draft notes<br />localhost:4321<br />Project checklist</small>
          </div>
          <div class="toybox-sync" data-toybox-sync aria-hidden="true">
            <span>PC</span><i></i><span>MAC</span>
          </div>
          <div class="toybox-cat" data-toybox-cat aria-label="The actual Toybox desktop cat sprite"></div>
          <figcaption>Monitor, clipboard, timer, and the real desktop cat sharing one small desktop.</figcaption>
        </figure>
      </article>
    </div>
  </section>

  <section class="print-list section-shell">
    <header>
      <p class="poster-kicker">More software</p>
      <h2>Other things I’m building.</h2>
    </header>
    <div class="print-list__rows">
      <a href="/projects/question-distiller/">
        <strong>Question Distiller / Structure Lab</strong>
        <span>Turns screenshot-only study documents into reviewed data and interactive chemistry lessons.</span>
      </a>
      <a href="/projects/">
        <strong>SAT World</strong>
        <span>SAT software for students, teachers, live classes, study plans, analytics, and pets.</span>
      </a>
      <a href="/projects/baddest/">
        <strong>Baddest</strong>
        <span>Turns repeated head-to-head choices into personal and shared rankings.</span>
      </a>
    </div>
  </section>

  <section class="print-notes">
    <div class="print-notes__burst" aria-hidden="true"></div>
    <p class="poster-kicker">Notes</p>
    <h2>Build logs, mistakes, and technical decisions.</h2>
    <p>
      Nothing is published yet. The first posts will come from these projects:
      mechanics that changed, systems that broke, and decisions worth documenting.
    </p>
    <a href="/notes/">Notes index <span aria-hidden="true">↗</span></a>
  </section>

  <section class="poster-coda">
    <div class="poster-coda__sun" aria-hidden="true"></div>
    <div class="poster-coda__mountain poster-coda__mountain--far" aria-hidden="true"></div>
    <div class="poster-coda__mountain poster-coda__mountain--near" aria-hidden="true"></div>
    <div class="poster-coda__water" aria-hidden="true"></div>
    <div class="poster-coda__copy">
      <p class="poster-kicker">Vancouver, British Columbia</p>
      <h2>Made here.</h2>
      <p>Usually for a problem I encountered here too.</p>
    </div>
  </section>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const posterWindow = window as typeof window & { __posterMotion?: ReturnType<typeof gsap.matchMedia> };
    posterWindow.__posterMotion?.revert();
    const motion = gsap.matchMedia();
    posterWindow.__posterMotion = motion;

    motion.add('(prefers-reduced-motion: no-preference) and (min-width: 861px)', () => {
      const opening = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-poster-hero]',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.55,
        },
      });

      opening
        .to('[data-poster-sun]', { scale: 1.45, xPercent: -13, yPercent: 5, ease: 'none' }, 0)
        .to('[data-mountain-far]', { xPercent: -7, yPercent: 4, scale: 1.08, ease: 'none' }, 0)
        .to('[data-mountain-near]', { xPercent: 7, yPercent: 7, scale: 1.14, ease: 'none' }, 0)
        .to('[data-poster-city]', { xPercent: -9, scale: 1.12, ease: 'none' }, 0)
        .to('[data-poster-crane]', { xPercent: 12, scale: 1.18, ease: 'none' }, 0)
        .to('[data-poster-water]', { yPercent: 12, scale: 1.08, ease: 'none' }, 0)
        .to('[data-poster-seabus]', { xPercent: 95, yPercent: 8, scale: 1.05, ease: 'none' }, 0)
        .to('[data-poster-copy]', { xPercent: -28, rotate: -2, opacity: 0, ease: 'none' }, 0.18)
        .to('[data-poster-stamp]', { xPercent: -45, yPercent: 25, rotate: -17, opacity: 0, ease: 'none' }, 0.23)
        .fromTo('[data-poster-aperture]',
          { xPercent: 44, yPercent: 32, scale: 0.08, rotate: 8, opacity: 0 },
          { xPercent: 0, yPercent: 0, scale: 1, rotate: -1.5, opacity: 1, ease: 'power2.inOut' },
          0.28,
        )
        .to('[data-poster-scene]', { scale: 1.08, filter: 'saturate(0.84) brightness(0.8)', ease: 'none' }, 0.58);

      const chapters = gsap.utils.toArray<HTMLElement>('[data-print-chapter]');
      gsap.set(chapters.slice(1), { autoAlpha: 0 });

      const bullets = gsap.utils.toArray<HTMLElement>('[data-goldwake-bullets] i');
      const coins = gsap.utils.toArray<HTMLElement>('[data-goldwake-coins] i');
      const stars = gsap.utils.toArray<HTMLElement>('[data-agame-stars] i');
      const freecatWindows = gsap.utils.toArray<HTMLElement>('[data-freecat-window]');

      gsap.set(chapters, { x: 0, y: 0 });
      gsap.set(chapters.map((chapter) => chapter.querySelector('.print-chapter__copy')), {
        x: 0,
        y: 0,
        xPercent: 0,
        autoAlpha: 1,
      });
      gsap.set(bullets, { autoAlpha: 0, scale: 0.4 });
      gsap.set(coins, { autoAlpha: 0, scale: 0 });
      gsap.set('[data-goldwake-scene]', { clipPath: 'inset(0)' });
      gsap.set('[data-agame-clearing]', { clipPath: 'inset(0 0 0 100%)' });
      gsap.set('[data-agame-galaxy]', { clipPath: 'inset(100% 0 0 0)' });
      gsap.set(stars, { autoAlpha: 0, y: 18 });
      gsap.set('[data-freecat-window="qbank"]', { xPercent: 86, yPercent: 4, rotate: 5, autoAlpha: 0 });
      gsap.set('[data-freecat-window="content"]', { xPercent: -86, yPercent: 8, rotate: -5, autoAlpha: 0 });
      gsap.set('[data-freecat-database]', { scale: 0.7, autoAlpha: 0 });
      gsap.set('[data-freecat-route]', { scaleX: 0 });
      gsap.set('[data-toybox-window="system"]', { xPercent: -135, rotate: -7, autoAlpha: 0 });
      gsap.set('[data-toybox-window="timer"]', { yPercent: -135, rotate: 6, autoAlpha: 0 });
      gsap.set('[data-toybox-window="clipboard"]', { xPercent: 135, yPercent: 35, rotate: 5, autoAlpha: 0 });
      gsap.set('[data-toybox-sync] i', { scaleX: 0 });
      gsap.set('[data-toybox-cat]', { xPercent: -180, autoAlpha: 0 });

      const film = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-print-film]',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.6,
        },
      });

      const coinVector = (target: HTMLElement, axis: 'x' | 'y') => {
        const angle = Number.parseFloat(target.style.getPropertyValue('--angle')) * (Math.PI / 180);
        const distance = Number.parseFloat(target.style.getPropertyValue('--distance')) * 16;
        return (axis === 'x' ? Math.cos(angle) : Math.sin(angle)) * distance;
      };

      film
        // Goldwake begins as the portrait game itself, then performs its core mechanic.
        .to('[data-film-ink]', { backgroundColor: '#071311', duration: 0.18, ease: 'none' }, 0)
        .to('[data-goldwake-depth]', { xPercent: -7, yPercent: -2, duration: 1.5, ease: 'none' }, 0)
        .to('[data-goldwake-structure]', { xPercent: 6, scale: 1.08, duration: 1.5, ease: 'none' }, 0)
        .fromTo('[data-goldwake-screen]',
          { yPercent: 8, rotateY: -5 },
          { yPercent: -3, rotateY: 4, duration: 0.86, ease: 'none' },
          0.12,
        )
        .to(bullets, { autoAlpha: 1, scale: 1, duration: 0.22, stagger: 0.025, ease: 'back.out(2)' }, 0.24)
        .to(bullets, {
          left: (_index, target) => (target as HTMLElement).style.getPropertyValue('--tx'),
          top: (_index, target) => (target as HTMLElement).style.getPropertyValue('--ty'),
          duration: 0.54,
          stagger: 0.012,
          ease: 'power1.in',
        }, 0.52)
        .to('[data-goldwake-wave]', { autoAlpha: 1, scale: 7.5, duration: 0.32, ease: 'power3.out' }, 0.98)
        .to(bullets, { autoAlpha: 0, scale: 0.1, duration: 0.16, stagger: 0.012, ease: 'power2.in' }, 1.02)
        .fromTo(coins,
          { x: 0, y: 0, scale: 0, autoAlpha: 0 },
          {
            x: (_index, target) => coinVector(target as HTMLElement, 'x'),
            y: (_index, target) => coinVector(target as HTMLElement, 'y'),
            scale: 1,
            autoAlpha: 1,
            duration: 0.34,
            stagger: 0.025,
            ease: 'back.out(2.4)',
          },
          1.04,
        )
        .to('[data-goldwake-debris]', { rotate: -2, scale: 1.08, duration: 1.25, ease: 'none' }, 0.18)

        // A-Game wipes over a complete Goldwake scene; the frame is never left empty.
        .to(chapters[0].querySelector('.print-chapter__copy'), { y: -24, autoAlpha: 0, duration: 0.25, ease: 'power2.in' }, 1.48)
        .set(chapters[1], { autoAlpha: 1 }, 1.5)
        .fromTo(chapters[1].querySelector('.print-chapter__copy'),
          { y: 42, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 0.34, ease: 'power3.out' },
          1.84,
        )
        .fromTo('[data-agame-scene]',
          { clipPath: 'inset(100% 0 0 0)' },
          { clipPath: 'inset(0% 0 0 0)', duration: 0.42, ease: 'power3.inOut' },
          1.52,
        )
        .to('[data-film-ink]', { backgroundColor: '#3154a6', duration: 0.3, ease: 'none' }, 1.52)
        .set(chapters[0], { autoAlpha: 0 }, 1.98)

        // A-Game travels through three real scenes instead of holding on one frame.
        .to('[data-agame-outside]', { xPercent: -7, duration: 0.82, ease: 'none' }, 1.68)
        .to('[data-agame-clearing]', { clipPath: 'inset(0 0 0 0%)', duration: 0.54, ease: 'power2.inOut' }, 2.02)
        .fromTo('[data-agame-keepsakes] img',
          { y: -72, rotate: -9, autoAlpha: 0 },
          { y: 0, rotate: 0, autoAlpha: 1, duration: 0.28, stagger: 0.055, ease: 'back.out(1.8)' },
          2.16,
        )
        .fromTo('[data-agame-boat]',
          { xPercent: -125, yPercent: 12, rotate: -3, autoAlpha: 0 },
          { xPercent: 0, yPercent: 0, rotate: 0, autoAlpha: 1, duration: 0.38, ease: 'power2.out' },
          2.22,
        )
        .to('[data-agame-keepsakes] img', { y: 58, scale: 0.25, autoAlpha: 0, duration: 0.3, stagger: 0.045, ease: 'power2.in' }, 2.48)
        .to('[data-agame-galaxy]', { clipPath: 'inset(0% 0 0 0)', duration: 0.64, ease: 'power3.inOut' }, 2.52)
        .to('[data-agame-clearing]', { yPercent: -5, duration: 0.64, ease: 'none' }, 2.52)
        .to('[data-agame-boat]', { xPercent: 430, yPercent: -18, rotate: 1, duration: 0.82, ease: 'none' }, 2.56)
        .to(stars, { autoAlpha: 1, y: 0, duration: 0.28, stagger: 0.035, ease: 'power2.out' }, 2.67)
        .to(stars, { x: 28, y: -18, duration: 0.65, stagger: 0.025, ease: 'none' }, 2.88)

        // The FreeCAT desktop wipes across the galaxy while the previous frame remains intact.
        .to(chapters[1].querySelector('.print-chapter__copy'), { y: -36, autoAlpha: 0, duration: 0.24, ease: 'power2.in' }, 3.24)
        .set(chapters[2], { autoAlpha: 1 }, 3.32)
        .fromTo('[data-freecat-scene]',
          { clipPath: 'inset(0 100% 0 0)' },
          { clipPath: 'inset(0% 0 0 0)', duration: 0.42, ease: 'power3.inOut' },
          3.3,
        )
        .fromTo(chapters[2].querySelector('.print-chapter__copy'),
          { x: -44, autoAlpha: 0 },
          { x: 0, autoAlpha: 1, duration: 0.32, ease: 'power3.out' },
          3.74,
        )
        .to('[data-film-ink]', { backgroundColor: '#79b9a5', duration: 0.28, ease: 'none' }, 3.31)
        .set(chapters[1], { autoAlpha: 0 }, 3.76)

        // FreeCAT routes through its real screens while the local file stays fixed.
        .to('[data-freecat-database]', { scale: 1, autoAlpha: 1, duration: 0.28, ease: 'back.out(2)' }, 3.52)
        .to('[data-freecat-route]', { scaleX: 1, duration: 0.42, ease: 'power2.out' }, 3.54)
        .to('[data-freecat-window="home"]', { xPercent: -38, yPercent: 9, rotate: -4, scale: 0.82, filter: 'saturate(0.7)', duration: 0.42, ease: 'power3.inOut' }, 3.86)
        .to('[data-freecat-window="qbank"]', { xPercent: 0, yPercent: 0, rotate: 0, autoAlpha: 1, duration: 0.46, ease: 'power3.out' }, 3.9)
        .to('[data-freecat-window="qbank"]', { xPercent: 38, yPercent: 10, rotate: 4, scale: 0.82, filter: 'saturate(0.72)', duration: 0.42, ease: 'power3.inOut' }, 4.36)
        .to('[data-freecat-window="content"]', { xPercent: 0, yPercent: 0, rotate: 0, autoAlpha: 1, duration: 0.46, ease: 'power3.out' }, 4.4)
        .to('[data-freecat-database] i', { boxShadow: '0 0 0 0.7rem rgba(121,185,165,0)', duration: 0.38, ease: 'power2.out' }, 4.46)

        // The windows fold into the file, then Toybox opens over the intact desktop.
        .to(freecatWindows, { xPercent: 43, yPercent: 46, scale: 0.14, rotate: 0, autoAlpha: 0, duration: 0.36, stagger: 0.035, ease: 'power3.in' }, 4.96)
        .to('[data-freecat-route]', { scaleX: 0, duration: 0.26, ease: 'power2.in' }, 4.98)
        .to(chapters[2].querySelector('.print-chapter__copy'), { y: -24, autoAlpha: 0, duration: 0.25, ease: 'power2.in' }, 5.04)
        .set(chapters[3], { autoAlpha: 1 }, 5.12)
        .fromTo('[data-toybox-scene]',
          { clipPath: 'circle(0% at 50% 50%)' },
          { clipPath: 'circle(74% at 50% 50%)', duration: 0.5, ease: 'power3.inOut' },
          5.08,
        )
        .fromTo(chapters[3].querySelector('.print-chapter__copy'),
          { y: 38, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 0.34, ease: 'power3.out' },
          5.38,
        )
        .to('[data-film-ink]', { backgroundColor: '#0b1c24', duration: 0.3, ease: 'none' }, 5.12)
        .set(chapters[2], { autoAlpha: 0 }, 5.62)

        // Toybox assembles like the utilities themselves: independent, small, useful.
        .to('[data-toybox-window="system"]', { xPercent: 0, rotate: 0, autoAlpha: 1, duration: 0.34, ease: 'back.out(1.7)' }, 5.14)
        .to('[data-toybox-window="timer"]', { yPercent: 0, rotate: 0, autoAlpha: 1, duration: 0.34, ease: 'back.out(1.7)' }, 5.28)
        .to('[data-toybox-window="clipboard"]', { xPercent: 0, yPercent: 0, rotate: 0, autoAlpha: 1, duration: 0.38, ease: 'back.out(1.7)' }, 5.42)
        .to('[data-toybox-sync] i', { scaleX: 1, duration: 0.42, ease: 'steps(6)' }, 5.88)
        .to('[data-toybox-cat]', { xPercent: 0, autoAlpha: 1, duration: 0.2, ease: 'none' }, 5.86)
        .to('[data-toybox-cat]', { xPercent: 650, duration: 0.78, ease: 'none' }, 5.94)
        .to('.toybox-timer__time--one', { autoAlpha: 0, duration: 0.12, ease: 'none' }, 6.14)
        .to('[data-toybox-time]', { autoAlpha: 1, duration: 0.12, ease: 'none' }, 6.14)
        .to('[data-toybox-window="system"]', { y: -8, duration: 0.5, ease: 'none' }, 6.16)
        .to('[data-toybox-window="clipboard"]', { y: 8, duration: 0.5, ease: 'none' }, 6.16);

      gsap.from('.print-list__rows > a', {
        y: 36,
        opacity: 0,
        duration: 0.7,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.print-list', start: 'top 78%', once: true },
      });

      gsap.from('.poster-coda__copy > *', {
        y: 32,
        opacity: 0,
        duration: 0.8,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.poster-coda', start: 'top 70%', once: true },
      });

      gsap.timeline({
        scrollTrigger: {
          trigger: '.print-notes',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.7,
        },
      })
        .fromTo('.print-notes__burst', { rotate: -28, scale: 0.72 }, { rotate: 22, scale: 1.16, ease: 'none' })
        .fromTo('.print-notes h2', { xPercent: -8 }, { xPercent: 5, ease: 'none' }, 0);

      gsap.timeline({
        scrollTrigger: {
          trigger: '.poster-coda',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.7,
        },
      })
        .fromTo('.poster-coda__sun', { yPercent: 28 }, { yPercent: -18, ease: 'none' })
        .fromTo('.poster-coda__mountain--far', { xPercent: -5 }, { xPercent: 4, ease: 'none' }, 0)
        .fromTo('.poster-coda__mountain--near', { xPercent: 4 }, { xPercent: -5, ease: 'none' }, 0)
        .fromTo('.poster-coda__water', { backgroundPositionY: '0rem' }, { backgroundPositionY: '4rem', ease: 'none' }, 0);

      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
    });
  </script>
</BaseLayout>
