---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout pageClass="home-page home-page--poster">
  <section class="poster-hero" data-poster-hero>
    <div class="poster-hero__sticky">
      <div class="poster-scene" data-poster-scene aria-hidden="true">
        <div class="poster-sun" data-poster-sun></div>
        <div class="poster-rain poster-rain--back" data-rain-back></div>
        <div class="poster-mountain poster-mountain--far" data-mountain-far></div>
        <div class="poster-mountain poster-mountain--near" data-mountain-near></div>

        <div class="poster-city" data-poster-city>
          <span style="--x: 2%; --w: 7%; --h: 42%;"></span>
          <span style="--x: 10%; --w: 5%; --h: 68%;"></span>
          <span style="--x: 17%; --w: 9%; --h: 51%;"></span>
          <span style="--x: 28%; --w: 6%; --h: 81%;"></span>
          <span style="--x: 36%; --w: 11%; --h: 58%;"></span>
          <span style="--x: 49%; --w: 5%; --h: 73%;"></span>
          <span style="--x: 57%; --w: 10%; --h: 47%;"></span>
          <span style="--x: 70%; --w: 7%; --h: 62%;"></span>
          <span style="--x: 80%; --w: 13%; --h: 38%;"></span>
        </div>

        <div class="poster-crane" data-poster-crane>
          <span class="poster-crane__mast"></span>
          <span class="poster-crane__boom"></span>
          <span class="poster-crane__brace poster-crane__brace--one"></span>
          <span class="poster-crane__brace poster-crane__brace--two"></span>
          <span class="poster-crane__cable"></span>
          <span class="poster-crane__hook"></span>
        </div>

        <div class="poster-water" data-poster-water></div>
        <div class="poster-seabus" data-poster-seabus>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="poster-rain poster-rain--front" data-rain-front></div>
        <div class="poster-halftone"></div>
      </div>

      <div class="poster-copy" data-poster-copy>
        <p class="poster-kicker">Warren · software developer · Vancouver</p>
        <h1>Software for problems I actually have.</h1>
        <p>
          I make games, study software, and small desktop tools—usually because I
          want a version that does something existing software does not.
        </p>
      </div>

      <div class="poster-stamp" data-poster-stamp aria-hidden="true">
        Built in<br />Vancouver
      </div>

      <div class="poster-aperture" data-poster-aperture>
        <p>HUBRIS / Goldwake</p>
        <figure>
          <img src="/images/projects/goldwake-title.webp" alt="The HUBRIS title screen" />
        </figure>
        <span>Portrait bullet-hell · WebGL2</span>
      </div>
    </div>
  </section>

  <section class="print-film" data-print-film aria-label="Selected projects">
    <div class="print-film__sticky">
      <div class="print-film__ink" data-film-ink aria-hidden="true"></div>
      <p class="print-film__label">Projects, shown working</p>

      <article class="print-chapter print-chapter--goldwake" data-print-chapter data-ink="#df4738">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">HUBRIS / Goldwake</p>
          <h2>A portrait bullet-hell where grazing charges the screen clear.</h2>
          <p>
            Grazing fills an Apotheosis gauge. Triggering it cancels every enemy
            bullet into collectible gold. The run seed also chooses the encounters
            and procedural score.
          </p>
          <p class="print-chapter__meta">WebGL2 · Canvas · WebAudio · JavaScript · playable locally</p>
          <a href="/projects/goldwake/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="print-chapter__media print-chapter__media--portrait">
          <img src="/images/projects/goldwake-title.webp" alt="The HUBRIS title screen" />
        </figure>
      </article>

      <article class="print-chapter print-chapter--agame" data-print-chapter data-ink="#3154a6">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">A-Game</p>
          <h2>A birthday game built for one person and one sitting.</h2>
          <p>
            You visit two friends, play games inside their computers, and bring three
            keepsakes home when a violin starts calling. The keepsakes become a lit
            paper boat before the water turns into a galaxy.
          </p>
          <p class="print-chapter__meta">Phaser · TypeScript · Electron · no fail states</p>
          <a href="/projects/a-game/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="print-chapter__media print-chapter__media--wide">
          <img src="/images/projects/a-game-clearing.webp" alt="The lantern-lit clearing near the end of A-Game" />
        </figure>
      </article>

      <article class="print-chapter print-chapter--freecat" data-print-chapter data-ink="#79b9a5">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">FreeCAT</p>
          <h2>Local-first MCAT study software in one SQLite file.</h2>
          <p>
            The question bank, lessons, imported Anki decks, review history, XP, and
            study pet all stay on the learner’s computer. No account and no hosted
            progress database.
          </p>
          <p class="print-chapter__meta">Electron · React · TypeScript · SQLite · in development</p>
          <a href="/projects/freecat/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="print-chapter__media print-chapter__media--wide print-chapter__media--light">
          <img src="/images/projects/freecat-home.webp" alt="FreeCAT running locally with a study pet and progress summary" />
        </figure>
      </article>

      <article class="print-chapter print-chapter--toybox" data-print-chapter data-ink="#e5aa2d">
        <div class="print-chapter__copy">
          <p class="print-chapter__name">Toybox</p>
          <h2>Small Windows utilities written in Python’s standard library.</h2>
          <p>
            Toybox combines a system HUD, an in-memory clipboard that syncs text to
            my Mac over the local network, and a pixel cat that dances to music, runs
            timers, naps in a box, and carries dropped files.
          </p>
          <p class="print-chapter__meta">Python · Tkinter · Win32 APIs · no telemetry</p>
          <a href="/projects/toybox/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="print-chapter__media print-chapter__media--square">
          <img src="/images/projects/toybox-staged.webp" alt="A sanitized Toybox staging using the real desktop cat sprite" />
        </figure>
      </article>
    </div>
  </section>

  <section class="print-list section-shell">
    <header>
      <p class="poster-kicker">More software</p>
      <h2>Other things I’m building.</h2>
    </header>
    <div class="print-list__rows">
      <a href="/projects/question-distiller/">
        <strong>Question Distiller / Structure Lab</strong>
        <span>Turns screenshot-only study documents into reviewed data and interactive chemistry lessons.</span>
      </a>
      <a href="/projects/">
        <strong>SAT World</strong>
        <span>SAT software for students, teachers, live classes, study plans, analytics, and pets.</span>
      </a>
      <a href="/projects/baddest/">
        <strong>Baddest</strong>
        <span>Turns repeated head-to-head choices into personal and shared rankings.</span>
      </a>
    </div>
  </section>

  <section class="print-notes">
    <div class="print-notes__burst" aria-hidden="true"></div>
    <p class="poster-kicker">Notes</p>
    <h2>Build logs, mistakes, and technical decisions.</h2>
    <p>
      Nothing is published yet. The first posts will come from these projects:
      mechanics that changed, systems that broke, and decisions worth documenting.
    </p>
    <a href="/notes/">Notes index <span aria-hidden="true">↗</span></a>
  </section>

  <section class="poster-coda">
    <div class="poster-coda__sun" aria-hidden="true"></div>
    <div class="poster-coda__mountain poster-coda__mountain--far" aria-hidden="true"></div>
    <div class="poster-coda__mountain poster-coda__mountain--near" aria-hidden="true"></div>
    <div class="poster-coda__water" aria-hidden="true"></div>
    <div class="poster-coda__copy">
      <p class="poster-kicker">Vancouver, British Columbia</p>
      <h2>Made here.</h2>
      <p>Usually for a problem I encountered here too.</p>
    </div>
  </section>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const motion = gsap.matchMedia();

    motion.add('(prefers-reduced-motion: no-preference) and (min-width: 861px)', () => {
      const opening = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-poster-hero]',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.55,
        },
      });

      opening
        .to('[data-poster-sun]', { scale: 1.45, xPercent: -13, yPercent: 5, ease: 'none' }, 0)
        .to('[data-mountain-far]', { xPercent: -7, yPercent: 4, scale: 1.08, ease: 'none' }, 0)
        .to('[data-mountain-near]', { xPercent: 7, yPercent: 7, scale: 1.14, ease: 'none' }, 0)
        .to('[data-poster-city]', { xPercent: -9, scale: 1.12, ease: 'none' }, 0)
        .to('[data-poster-crane]', { xPercent: 12, scale: 1.18, ease: 'none' }, 0)
        .to('[data-poster-water]', { yPercent: 12, scale: 1.08, ease: 'none' }, 0)
        .to('[data-poster-seabus]', { xPercent: 95, yPercent: 8, scale: 1.05, ease: 'none' }, 0)
        .to('[data-rain-back]', { xPercent: -9, yPercent: 13, ease: 'none' }, 0)
        .to('[data-rain-front]', { xPercent: 12, yPercent: 26, ease: 'none' }, 0)
        .to('[data-poster-copy]', { xPercent: -28, rotate: -2, opacity: 0, ease: 'none' }, 0.18)
        .to('[data-poster-stamp]', { xPercent: -45, yPercent: 25, rotate: -17, opacity: 0, ease: 'none' }, 0.23)
        .fromTo('[data-poster-aperture]',
          { xPercent: 44, yPercent: 32, scale: 0.08, rotate: 8, opacity: 0 },
          { xPercent: 0, yPercent: 0, scale: 1, rotate: -1.5, opacity: 1, ease: 'power2.inOut' },
          0.28,
        )
        .to('[data-poster-scene]', { scale: 1.08, filter: 'saturate(0.84) brightness(0.8)', ease: 'none' }, 0.58);

      const chapters = gsap.utils.toArray<HTMLElement>('[data-print-chapter]');
      gsap.set(chapters.slice(1), { autoAlpha: 0 });

      const film = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-print-film]',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.6,
        },
      });

      chapters.forEach((chapter, index) => {
        const media = chapter.querySelector('.print-chapter__media');
        const copy = chapter.querySelector('.print-chapter__copy');
        const ink = chapter.dataset.ink;
        const start = index;

        film.to('[data-film-ink]', { backgroundColor: ink, duration: 0.22, ease: 'none' }, start);

        if (index > 0) {
          const previous = chapters[index - 1];
          film
            .to(previous, { autoAlpha: 0, y: -32, duration: 0.24, ease: 'none' }, start)
            .fromTo(chapter, { autoAlpha: 0, y: 46 }, { autoAlpha: 1, y: 0, duration: 0.3, ease: 'power2.out' }, start + 0.13)
            .fromTo(media, { scale: 0.82, rotate: 3 }, { scale: 1, rotate: 0, duration: 0.42, ease: 'power3.out' }, start + 0.1)
            .fromTo(copy, { x: -32 }, { x: 0, duration: 0.34, ease: 'power2.out' }, start + 0.15);
        }

        film.to(media, { scale: 1.045, rotate: index % 2 === 0 ? -0.7 : 0.7, duration: 0.62, ease: 'none' }, start + 0.38);
      });

      gsap.from('.print-list__rows > a', {
        y: 36,
        opacity: 0,
        duration: 0.7,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.print-list', start: 'top 78%', once: true },
      });

      gsap.from('.poster-coda__copy > *', {
        y: 32,
        opacity: 0,
        duration: 0.8,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.poster-coda', start: 'top 70%', once: true },
      });

      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
    });
  </script>
</BaseLayout>
