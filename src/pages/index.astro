---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HarbourPrint from '@/components/HarbourPrint.astro';
import ToyboxScene from '@/components/ToyboxScene.astro';
---

<BaseLayout pageClass="home-page">
  <section class="home-opening section-shell">
    <div class="home-opening__copy">
      <h1><span class="opening-line opening-line--small"><span>Welcome to</span></span><span class="opening-line"><span>my weird</span></span><span class="opening-line opening-line--italic"><span>projects</span></span></h1>
    </div>
    <HarbourPrint />
  </section>

  <section class="work-index" id="projects" aria-label="Selected projects">
    <header class="section-heading section-shell" data-reveal>
      <h2><a class="category-journey" href="#project-gallery"><span class="category-word">Games</span>, <span class="category-word">study software</span>, and <span class="category-word">small tools</span>.<span class="category-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 7h9a3.5 3.5 0 0 1 3.4 2.7l1.6 7a2.4 2.4 0 0 1-4 2.3L15 16H9l-2.5 3a2.4 2.4 0 0 1-4-2.3l1.6-7A3.5 3.5 0 0 1 7.5 7Z"/><path d="M7 10v5m-2.5-2.5h5"/><circle cx="16.5" cy="11" r=".7"/><circle cx="18" cy="14" r=".7"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4H5a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-7M8 4v17M2 8h4m-4 5h4m-4 5h4m5-9h3m-3 4h2"/><path d="m14 13 1-4 6-6 2 2-6 6-3 2Zm5-8 2 2"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="13" rx="1.5"/><path d="m3 16-2 4h22l-2-4M10 20h4"/><path d="m8 12 5-5a2.5 2.5 0 0 1 3-2l-1.5 1.5 1.5 1.5L17 6.5a2.5 2.5 0 0 1-2 3l-5 5Z"/></svg>
      </span><svg class="category-effects" aria-hidden="true">{[0, 1, 2].map(() => <g><path class="category-trail" fill="none" /><g class="category-impact"><path d="M-4-3C-13-15-17-14-13-8C-10-5-6-3-4-3ZM0-5C-3-22 4-23 3-15C2-10 0-5 0-5ZM4-3C9-13 17-16 14-10C11-6 6-4 4-3Z" fill="none" /></g></g>)}</svg></a></h2>
      <a class="opening-index" href="#project-gallery" aria-label="Browse projects"><span aria-hidden="true">↓</span></a>
    </header>
<div class="work-reel" id="project-gallery"><div class="work-stage"><div class="reel-orbit" aria-hidden="true"></div>
<article class="work-row work-row--hubris"><div class="work-copy" data-reveal>
          <h2 class="work-title">Hubris</h2>
          <h3>A portrait bullet-hell where grazing charges the screen clear.</h3>
          <p>
            Grazing fills a hubris gauge. Triggering it cancels every enemy bullet
            into collectible gold. The run seed generates encounters procedurally.
          </p>
          <p class="work-meta">WebGL2 · Canvas · WebAudio · JavaScript · playable locally</p>
          <a href="/projects/hubris/">Project details <span aria-hidden="true">↗</span></a>
        </div><figure class="work-figure"><div class="work-media work-media--hubris" data-reveal>
  <img src="/images/projects/hubris-title.webp" alt="The HUBRIS title screen" width="900" height="1400" loading="lazy" />
  <img src="/images/projects/hubris-boon.webp" alt="HUBRIS paused at a three-boon choice during a run" width="900" height="1400" loading="lazy" />
  <div class="hubris-particles" aria-hidden="true">
    {Array.from({ length: 10 }, (_, i) => (
      <span class="hubris-particle" style={`--px:${50 + Math.cos(i * Math.PI / 5) * 43}%;--py:${50 + Math.sin(i * Math.PI / 5) * 43}%`}>
        <img class="hubris-projectile" src="/images/projects/hubris-assets/rune-bolt.png" alt="" loading="lazy" />
        <img class="hubris-gold" src="/images/projects/hubris-assets/gold-coin.png" alt="" loading="lazy" />
      </span>
    ))}
    <i class="hubris-energy"></i>
  </div>
</div></figure></article>
<article class="work-row work-row--agame"><div class="work-copy" data-reveal>
          <h2 class="work-title">RPG Birthday Card</h2>
          <h3>A personalised birthday RPG.</h3>
          <p>
            You visit two friends, play minigames you associate with them, and earn
            keepsakes. The keepsakes fold into a boat that goes to the ending scene.
          </p>
          <p class="work-meta">Phaser · TypeScript · Electron · no fail states</p>
          <a href="/projects/a-game/">Project details <span aria-hidden="true">↗</span></a>
        </div><figure class="work-figure"><div class="work-media work-media--agame" data-reveal>
  <img src="/images/projects/a-game-clearing.webp" alt="The lantern-lit clearing near the end of RPG Birthday Card" width="1600" height="1000" loading="lazy" />
  <img class="agame-ending" src="/images/projects/cinematic/a-game-galaxy.webp" alt="The water-to-galaxy transition from RPG Birthday Card’s ending" width="1600" height="1000" loading="lazy" />
  <img class="agame-boat" src="/images/projects/a-game-assets/alice-boat.png" alt="" aria-hidden="true" width="256" height="256" loading="lazy" />
  <img class="agame-inset" src="/images/projects/a-game-outside.webp" alt="The village outside the player’s house in RPG Birthday Card" width="1600" height="1000" loading="lazy" />
</div></figure></article>
<article class="work-row work-row--freecat"><div class="work-copy" data-reveal>
          <h2 class="work-title">FreeCAT</h2>
          <h3>In progress, a free, fully local MCAT study app.</h3>
          <p>
            Question bank, lessons, imported Anki decks, and review history data all
            stay local. No account or hosted database.
          </p>
          <p class="work-meta">Electron · React · TypeScript · SQLite · in development</p>
          <a href="/projects/freecat/">Project details <span aria-hidden="true">↗</span></a>
        </div><figure class="work-figure"><div class="work-media work-media--freecat" data-reveal>
  <div class="study-preview" data-study-preview>
    <img src="/images/projects/freecat-home.webp" alt="FreeCAT running locally with a study pet and progress summary" width="1600" height="1000" loading="lazy" data-study-image />
    <img src="/images/projects/freecat-qbank.webp" alt="FreeCAT question-bank practice setup" width="1600" height="1000" loading="lazy" data-study-image hidden />
    <img src="/images/projects/freecat-content.webp" alt="FreeCAT content-review topic list" width="1600" height="1000" loading="lazy" data-study-image hidden />
  </div>
  <img class="study-satellite study-satellite--qbank" src="/images/projects/freecat-qbank.webp" alt="" aria-hidden="true" loading="lazy" />
  <img class="study-satellite study-satellite--content" src="/images/projects/freecat-content.webp" alt="" aria-hidden="true" loading="lazy" />
  <div class="study-tabs" aria-label="FreeCAT screenshots">
    <button type="button" aria-pressed="true" data-study-tab>Home / study pet</button>
    <button type="button" aria-pressed="false" data-study-tab>Question bank</button>
    <button type="button" aria-pressed="false" data-study-tab>Content review</button>
  </div>
</div></figure></article>
<article class="work-row work-row--toybox"><div class="work-copy" data-reveal>
          <h2 class="work-title">Toybox</h2>
          <h3>Small Windows utilities written in Python</h3>
          <p>
            Toybox includes a system HUD using RSS, an in-memory clipboard that syncs
            text to Mac or other machines over the local network, and a pixel cat
            companion that dances to music, manages monitors, and runs timers
          </p>
          <p class="work-meta">Python · Tkinter · Win32 APIs · no telemetry</p>
          <a href="/projects/toybox/">Project details <span aria-hidden="true">↗</span></a>
        </div><figure class="work-figure"><div class="work-media work-media--toybox" data-reveal>
  <ToyboxScene />
</div></figure></article>
    <nav class="reel-nav" aria-label="Selected projects">
      <button type="button" data-reel-jump="0" aria-label="Hubris" aria-current="true"><span>Hubris</span></button>
      <button type="button" data-reel-jump="1" aria-label="RPG Birthday Card"><span>RPG Birthday Card</span></button>
      <button type="button" data-reel-jump="2" aria-label="FreeCAT"><span>FreeCAT</span></button>
      <button type="button" data-reel-jump="3" aria-label="Toybox"><span>Toybox</span></button>
      <span class="reel-progress" aria-hidden="true"><i></i></span>
    </nav>
    </div></div>
  </section>
  <section class="home-secondary section-shell">
    <div class="software-list" data-reveal>
      <div class="secondary-heading"><p class="eyebrow">More software</p><h2>Other things I’m building.</h2></div>
      <div class="software-items">
        <div class="software-item"><strong>SAT World</strong><span>SAT software for students, teachers, live classes, study plans, analytics</span></div>
        <div class="software-item"><strong>Neon Study HUD</strong><span>A lightweight cyberpunk visual layer for Anki desktop, with an upgradeable modular study starship.</span></div>
        <div class="software-item"><strong>Extra Butter, Please</strong><span>Private movie nights with synchronized playback, chat, and movie ratings.</span></div>
      </div>
    </div>
  </section>
  <script>
    import { gsap } from 'gsap';
    const journey = document.querySelector<HTMLAnchorElement>('.category-journey');
    const icon = journey?.querySelector<HTMLElement>('.category-icon');
    const words = Array.from(journey?.querySelectorAll<HTMLElement>('.category-word') ?? []);
    const icons = Array.from(icon?.querySelectorAll('svg') ?? []);
    const trails = Array.from(journey?.querySelectorAll<SVGPathElement>('.category-trail') ?? []);
    const impacts = Array.from(journey?.querySelectorAll<SVGGElement>('.category-impact') ?? []);
    let bounce: gsap.core.Timeline | undefined;
    const resetJourney = () => {
      bounce?.kill();
      gsap.set(words, { clearProps: 'color,transform' });
      if (icon) gsap.set(icon, { opacity: 0, scale: 1 });
      gsap.set([...trails, ...impacts], { opacity: 0 });
    };
    const playJourney = () => {
      if (!journey || !icon || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      resetJourney();
      const bounds = journey.getBoundingClientRect();
      const size = icon.getBoundingClientRect().width;
      const stops = words.map(word => {
        const box = word.getBoundingClientRect();
        return { x: box.left - bounds.left + box.width / 2 - size / 2, y: box.top - bounds.top - size - 8 };
      });
      gsap.set(icons, { opacity: 0, scale: .8, rotation: -12 });
      gsap.set(icons[0], { opacity: 1, scale: 1, rotation: 0 });
      gsap.set(icon, { x: words[0].offsetLeft - size - 10, y: stops[0].y, opacity: 1, scale: 1 });
      bounce = gsap.timeline();
      stops.forEach((stop, index) => {
        const previousY = index ? stops[index - 1].y : stop.y;
        const at = index * .49;
        const previousX = index ? stops[index - 1].x : words[0].offsetLeft - size - 10;
        const startX = previousX + size / 2;
        const endX = stop.x + size / 2;
        const startY = previousY + size / 2;
        const endY = stop.y + size / 2;
        const peakY = Math.min(startY, endY) - size * 2.5;
        trails[index].setAttribute('d', `M${startX},${startY} Q${(startX + endX) / 2},${peakY} ${endX},${endY}`);
        const length = trails[index].getTotalLength();
        gsap.set(trails[index], { strokeDasharray: length, strokeDashoffset: length, opacity: 0 });
        gsap.set(impacts[index], { x: endX, y: stop.y + size + 3, scale: .4, opacity: 0, transformOrigin: '0px 0px' });
        const flight = { progress: 0 };
        bounce!.set(trails[index], { opacity: .45 }, at)
          .to(flight, { progress: 1, duration: .45, ease: 'power1.inOut', onUpdate: () => {
            const distance = length * flight.progress;
            const point = trails[index].getPointAtLength(distance);
            gsap.set(icon, { x: point.x - size / 2, y: point.y - size / 2 });
            gsap.set(trails[index], { strokeDashoffset: length - distance });
          } }, at)
          .to(trails[index], { opacity: 0, duration: .3 }, at + .45)
          .to(impacts[index], { opacity: .8, scale: 1, duration: .06 }, at + .45)
          .to(impacts[index], { opacity: 0, scale: 1.5, duration: .22 }, at + .49);
        bounce!.to(icon, { scaleX: 1.12, scaleY: .86, duration: .06 }, at + .45)
          .to(icon, { scaleX: 1, scaleY: 1, duration: .1, ease: 'back.out(2)' }, at + .49)
          .set(words[index], { color: getComputedStyle(journey).getPropertyValue('--red').trim() }, at + .45)
          .to(words[index], { y: 3, duration: .06 }, at + .45)
          .to(words[index], { y: 0, duration: .18, ease: 'back.out(3)' }, at + .49);
        if (index) {
          bounce!.set(words[index - 1], { color: getComputedStyle(journey).color }, at + .45);
          bounce!.to(icons[index - 1], { opacity: 0, scale: .6, rotation: 12, duration: .2 }, at + .12)
            .to(icons[index], { opacity: 1, scale: 1, rotation: 0, duration: .25 }, at + .18);
        }
      });
    };
    journey?.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') playJourney(); });
    journey?.addEventListener('pointerleave', resetJourney);
    journey?.addEventListener('focus', playJourney);
    journey?.addEventListener('blur', resetJourney);
    window.addEventListener('resize', resetJourney);
    const galleryLinks = document.querySelectorAll<HTMLAnchorElement>('.opening-index, .category-journey');
    const gallery = document.querySelector<HTMLElement>('#project-gallery');
    galleryLinks.forEach(link => link.addEventListener('click', (event) => {
      if (!gallery) return;
      event.preventDefault();
      const headerHeight = document.querySelector('.site-header')?.getBoundingClientRect().height ?? 0;
      window.scrollTo({
        top: window.scrollY + gallery.getBoundingClientRect().top - headerHeight,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
    }));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-study-tab]'));
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('[data-study-image]'));
    tabs.forEach((tab, index) => tab.addEventListener('click', () => {
      tabs.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
      images.forEach((image, i) => { image.hidden = i !== index; });
    }));
  </script>
</BaseLayout>
