        .to('[data-toybox-cat]', { xPercent: 0, autoAlpha: 1, duration: 0.18, ease: 'none' }, 'toybox+=0.1')
        .to('[data-toybox-cat]', { xPercent: 180, duration: 0.36, ease: 'none' }, 'toybox+=0.3')
        .to('[data-toybox-cat]', { xPercent: 420, duration: 0.5, ease: 'none' }, 'toybox+=0.78')
        .to('[data-toybox-packet]', { autoAlpha: 1, duration: 0.1, ease: 'none' }, 'toybox+=0.48')
        .to('[data-toybox-packet]', { xPercent: 1150, duration: 0.58, ease: 'none' }, 'toybox+=0.52')
        .to('[data-toybox-packet]', { autoAlpha: 0, duration: 0.1, ease: 'none' }, 'toybox+=1.1');

      gsap.from('.print-list__rows > a', {
        x: -18,
        opacity: 0,
        clipPath: 'inset(0 100% 0 0)',
        duration: 0.58,
        stagger: 0.1,
        ease: 'power2.out',
        scrollTrigger: { trigger: '.print-list', start: 'top 78%', once: true },
      });

      gsap.from('.poster-coda__copy > *', {
        y: 32,
        opacity: 0,
        duration: 0.8,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.poster-coda', start: 'top 70%', once: true },
      });

      gsap.timeline({
        scrollTrigger: {
          trigger: '.print-notes',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.7,
        },
      })
        .fromTo('.print-notes__burst', { rotate: -22, scale: 0.76 }, { rotate: 18, scale: 1.12, ease: 'none' });

      gsap.timeline({
        scrollTrigger: {
          trigger: '.poster-coda',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.7,
        },
      })
        .fromTo('.poster-coda__sun', { yPercent: 58 }, { yPercent: -12, ease: 'none' })
        .fromTo('.poster-coda__mountain--far', { xPercent: -2 }, { xPercent: 2, ease: 'none' }, 0)
        .fromTo('.poster-coda__mountain--near', { xPercent: 2 }, { xPercent: -2, ease: 'none' }, 0)
        .fromTo('.poster-coda__water', { backgroundPositionY: '0rem' }, { backgroundPositionY: '4rem', ease: 'none' }, 0);

      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
    });
  </script>
</BaseLayout>
