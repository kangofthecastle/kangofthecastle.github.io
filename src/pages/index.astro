        .set('[data-freecat-window="qbank"]', { autoAlpha: 1 }, 'freecat+=0.45')
        .to('[data-freecat-window="qbank"]', { clipPath: 'inset(0 0% 0 0)', duration: 0.42, ease: 'power2.inOut' }, 'freecat+=0.45')
        .to('[data-freecat-window="home"]', { autoAlpha: 0, duration: 0.16, ease: 'none' }, 'freecat+=0.7')
        .to('[data-freecat-database] i', { boxShadow: '0 0 0 0.72rem rgba(121,185,165,0)', duration: 0.34, ease: 'power2.out' }, 'freecat+=0.52')
        .set('[data-freecat-window="content"]', { autoAlpha: 1 }, 'freecat+=1.02')
        .to('[data-freecat-window="content"]', { clipPath: 'inset(0 0% 0 0)', duration: 0.42, ease: 'power2.inOut' }, 'freecat+=1.02')
        .to('[data-freecat-window="qbank"]', { autoAlpha: 0, duration: 0.16, ease: 'none' }, 'freecat+=1.27')
        .to('[data-freecat-database] i', { boxShadow: '0 0 0 0.72rem rgba(121,185,165,0)', duration: 0.34, ease: 'power2.out' }, 'freecat+=1.09');

      addFluidTransition('toToybox', 9.72, chapters[2], chapters[3], '#79b9a5', '#0b1c24');

      film
