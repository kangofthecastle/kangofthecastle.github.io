---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout pageClass="home-page home-page--harbour">
  <section class="harbour-hero" data-harbour-hero>
    <div class="harbour-hero__sticky">
      <figure class="harbour-view" aria-hidden="true">
        <img src="/images/vancouver-port.jpg" alt="" data-harbour-photo />
        <span class="harbour-view__shade"></span>
        <span class="harbour-view__water"></span>
      </figure>

      <div class="harbour-copy" data-harbour-copy>
        <p class="harbour-label">Warren · Vancouver, British Columbia</p>
        <h1>Games, study software, and small tools.</h1>
        <p>
          I’m a developer in Vancouver. I build software when the version I want
          does not exist yet—sometimes for myself, sometimes for one person I know.
        </p>
      </div>

      <figure class="harbour-portal" data-harbour-portal>
        <img src="/images/projects/goldwake-title.webp" alt="The HUBRIS title screen" />
        <figcaption>
          <strong>HUBRIS / Goldwake</strong>
          <span>Portrait bullet-hell roguelite</span>
        </figcaption>
      </figure>

      <p class="harbour-handoff" data-harbour-handoff>Projects</p>
    </div>
  </section>

  <section class="project-film" data-project-film aria-label="Selected projects">
    <div class="project-film__sticky">
      <p class="project-film__label">Selected projects</p>

      <article class="film-chapter film-chapter--goldwake" data-film-chapter="goldwake">
        <div class="film-chapter__copy">
          <p class="film-chapter__name">HUBRIS / Goldwake</p>
          <h2>A portrait bullet hell built around one escape mechanic.</h2>
          <p>
            Grazing fills an Apotheosis gauge. Triggering it cancels every enemy
            bullet on screen into collectible gold, so the same pressure that nearly
            ends a run can fund the next one. The run seed chooses the encounters and
            the procedural score.
          </p>
          <p class="film-chapter__meta">WebGL2 · Canvas · WebAudio · JavaScript · playable locally</p>
          <a href="/projects/goldwake/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="film-chapter__media film-chapter__media--portrait">
          <img src="/images/projects/goldwake-title.webp" alt="The HUBRIS title screen" />
        </figure>
      </article>

      <article class="film-chapter film-chapter--agame" data-film-chapter="agame">
        <div class="film-chapter__copy">
          <p class="film-chapter__name">A-Game</p>
          <h2>A birthday present you can walk around in.</h2>
          <p>
            You visit two friends, fish inside one computer, defuse a small top-down
            game inside another, and bring three keepsakes home when a violin starts
            calling. The keepsakes become a lit paper boat before the water turns into a galaxy.
          </p>
          <p class="film-chapter__meta">Phaser · TypeScript · Vite · Electron · one sitting, no fail states</p>
          <a href="/projects/a-game/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="film-chapter__media film-chapter__media--landscape">
          <img src="/images/projects/a-game-clearing.webp" alt="The lantern-lit clearing near the end of A-Game" />
        </figure>
      </article>

      <article class="film-chapter film-chapter--freecat" data-film-chapter="freecat">
        <div class="film-chapter__copy">
          <p class="film-chapter__name">FreeCAT</p>
          <h2>An MCAT app with no account and one local database.</h2>
          <p>
            Questions, lesson progress, imported Anki decks, review history, XP, and
            the study pet live in one SQLite file. The question bank, content review,
            gamification, and Anki import work now; FSRS review, richer media support,
            image occlusion, installers, and a public repository are still in progress.
          </p>
          <p class="film-chapter__meta">Electron · React · TypeScript · SQLite · original or open content only</p>
          <a href="/projects/freecat/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="film-chapter__media film-chapter__media--landscape film-chapter__media--light">
          <img src="/images/projects/freecat-home.webp" alt="FreeCAT running locally with a study pet and progress summary" />
        </figure>
      </article>

      <article class="film-chapter film-chapter--toybox" data-film-chapter="toybox">
        <div class="film-chapter__copy">
          <p class="film-chapter__name">Toybox</p>
          <h2>Small Windows utilities without another large desktop app.</h2>
          <p>
            Toybox includes a system and media HUD, an in-memory clipboard history
            that syncs text to my Mac over the local network, and a pixel cat that
            dances to music, runs focus timers, naps in a box, and carries dropped files.
          </p>
          <p class="film-chapter__meta">Python standard library · Tkinter · Win32 APIs · no telemetry</p>
          <a href="/projects/toybox/">Project details <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="film-chapter__media film-chapter__media--square">
          <img src="/images/projects/toybox-staged.webp" alt="A sanitized Toybox staging using the real desktop cat sprite" />
        </figure>
      </article>
    </div>
  </section>

  <section class="plain-work section-shell">
    <header>
      <p class="harbour-label">Other projects</p>
      <h2>Study pipelines, class software, and experiments.</h2>
    </header>
    <div class="plain-work__rows">
      <a href="/projects/question-distiller/">
        <strong>Question Distiller / Structure Lab</strong>
        <span>Turns screenshot-only study documents into reviewed data and interactive chemistry lessons.</span>
      </a>
      <a href="/projects/">
        <strong>SAT World</strong>
        <span>Invite-only SAT software for students, teachers, live classes, study plans, analytics, and pets.</span>
      </a>
      <a href="/projects/baddest/">
        <strong>Baddest</strong>
        <span>Turns repeated head-to-head choices into personal and shared rankings.</span>
      </a>
    </div>
  </section>

  <section class="plain-notes section-shell">
    <p class="harbour-label">Notes</p>
    <h2>Build logs and technical notes will live here.</h2>
    <p>
      There are no published posts yet. The first entries will come from these projects:
      mechanics that changed, systems that broke, and decisions worth documenting.
      <a href="/notes/">Notes index <span aria-hidden="true">↗</span></a>
    </p>
  </section>

  <section class="harbour-coda">
    <img src="/images/vancouver-port.jpg" alt="The Port of Vancouver at night with the North Shore mountains behind it" />
    <span class="harbour-coda__shade" aria-hidden="true"></span>
    <div class="harbour-coda__copy">
      <p class="harbour-label">Vancouver, British Columbia</p>
      <h2>Home.</h2>
    </div>
    <a class="harbour-credit" href="https://unsplash.com/pt-br/fotografias/porto-industrial-com-guindastes-iluminados-a-noite-NfOZ_Of6DZU" target="_blank" rel="noreferrer">
      Vancouver harbour photograph by Albert Stoynov / Unsplash
    </a>
  </section>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const motion = gsap.matchMedia();

    motion.add('(prefers-reduced-motion: no-preference) and (min-width: 861px)', () => {
      const harbour = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-harbour-hero]',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.7,
        },
      });

      harbour
        .fromTo('[data-harbour-photo]',
          { scale: 1.01, xPercent: 0, yPercent: 0, filter: 'brightness(0.76) saturate(0.82)' },
          { scale: 1.22, xPercent: -3, yPercent: 1, filter: 'brightness(0.34) saturate(0.7)', ease: 'none' },
          0,
        )
        .to('[data-harbour-copy]', { x: -72, y: -28, opacity: 0, ease: 'none' }, 0.16)
        .fromTo('[data-harbour-portal]',
          { xPercent: 110, yPercent: 18, scale: 0.14, rotateY: -12, opacity: 0 },
          { xPercent: 0, yPercent: 0, scale: 1, rotateY: 0, opacity: 1, ease: 'none' },
          0.16,
        )
        .fromTo('[data-harbour-handoff]',
          { y: 24, opacity: 0 },
          { y: 0, opacity: 1, ease: 'none' },
          0.78,
        );

      const chapters = gsap.utils.toArray<HTMLElement>('[data-film-chapter]');
      gsap.set(chapters.slice(1), { autoAlpha: 0 });

      const film = gsap.timeline({
        scrollTrigger: {
          trigger: '[data-project-film]',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.65,
        },
      });

      chapters.forEach((chapter, index) => {
        const media = chapter.querySelector('.film-chapter__media');
        const copy = chapter.querySelector('.film-chapter__copy');
        const start = index;

        if (index > 0) {
          const previous = chapters[index - 1];
          film
            .to(previous, { autoAlpha: 0, duration: 0.28, ease: 'none' }, start)
            .fromTo(chapter, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.32, ease: 'none' }, start + 0.14)
            .fromTo(media, { scale: 0.94, y: 28 }, { scale: 1, y: 0, duration: 0.46, ease: 'power2.out' }, start + 0.12)
            .fromTo(copy, { y: 22 }, { y: 0, duration: 0.38, ease: 'power2.out' }, start + 0.15);
        }

        film.to(media, { scale: 1.035, duration: 0.58, ease: 'none' }, start + 0.42);
      });

      gsap.from('.plain-work__rows > a, .plain-notes > *, .harbour-coda__copy > *', {
        y: 28,
        opacity: 0,
        duration: 0.75,
        stagger: 0.07,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.plain-work', start: 'top 82%', once: true },
      });

      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
    });
  </script>
</BaseLayout>
