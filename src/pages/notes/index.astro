---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="Notes — Warren"
  description="Build logs and technical notes from Warren's games, study software, and personal tools."
  pageClass="inner-page"
>
  <header class="page-hero page-hero--notes">
    <p class="eyebrow">Notes</p>
    <h1>Build logs and<br /><em>technical notes.</em></h1>
    <p>What changed, what broke, how a mechanic works, and why I made a particular trade-off.</p>
  </header>

  <section class="notes-index section-shell">
    {notes.length > 0 ? (
      <ol>
        {notes.map((note) => (
          <li>
            <a href={`/notes/${note.id}/`}>
              <div>
                <time datetime={note.data.publishedAt.toISOString()}>
                  {note.data.publishedAt.toLocaleDateString('en-CA', {
                    year: 'numeric', month: 'short', day: '2-digit',
                  })}
                </time>
                <h2>{note.data.title}</h2>
                <p>{note.data.summary}</p>
              </div>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty-notebook">
        <div>
          <h2>There are no published posts yet.</h2>
          <p>The blog is ready, but I am not filling it with placeholder essays. The first posts will come from the project writeups already underway.</p>
        </div>
        <div class="empty-notebook__prompts">
          <span>Good first subjects</span>
          <ul>
            <li>How Apotheosis changes the economy in HUBRIS</li>
            <li>Why FreeCAT stores everything in one SQLite file</li>
            <li>What had to stay private in the birthday game</li>
            <li>How Toybox keeps clipboard history from becoming permanent</li>
          </ul>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
