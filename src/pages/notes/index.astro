---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="Notes — Warren"
  description="Build logs and technical notes from Warren's games, study software, and personal tools."
  pageClass="inner-page notes-page"
>
  <header class="page-hero page-hero--notes">
    <p class="eyebrow">Notes</p>
    <h1>Notes from<br /><em>the workshop.</em></h1>
    <p>Build logs, things that broke, and the decisions behind the projects.</p>
  </header>

  <section class="notes-index section-shell">
    {notes.length > 0 ? (
      <ol>
        {notes.map((note) => (
          <li>
            <a href={`/notes/${note.id}/`}>
              <div>
                <time datetime={note.data.publishedAt.toISOString()}>
                  {note.data.publishedAt.toLocaleDateString('en-CA', {
                    year: 'numeric', month: 'short', day: '2-digit',
                  })}
                </time>
                <h2>{note.data.title}</h2>
                <p>{note.data.summary}</p>
              </div>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <div class="notes-empty">
        <div class="notes-empty__graphic" aria-hidden="true"><span>W</span><i></i><i></i><i></i></div>
        <div>
          <p class="eyebrow">The first page is still blank</p>
          <h2>Nothing published.<br />Plenty in progress.</h2>
          <p>No notes here yet. In the meantime, the project pages cover what I wanted to build, how each thing works, and where it is now.</p>
          <a class="button button--primary" href="/projects/">Explore the projects <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
