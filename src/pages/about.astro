---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="About — Warren"
  description="A developer in Vancouver making personal tools, games, learning systems, and experiments."
  pageClass="inner-page"
>
  <header class="page-hero page-hero--about">
    <p class="eyebrow">About / still in motion</p>
    <h1>A developer drawn to<br /><em>useful oddities.</em></h1>
    <p>This page is intentionally a strong first draft, with room for the biography, interests, and personal details that should come directly from you.</p>
  </header>

  <section class="about-intro section-shell">
    <div class="about-intro__portrait" aria-label="Portrait space reserved">
      <span>Portrait optional</span>
      <div aria-hidden="true">W/</div>
      <p>Artifact-first works too.</p>
    </div>
    <div class="about-intro__copy prose-large">
      <p>I’m {site.publicName}, a developer in {site.location}. I like making software for needs that are too particular, too playful, or too personal to survive a normal product brief.</p>
      <p>The work moves between games, learning systems, desktop utilities, visual experiments, and tools that make one person’s day work a little better.</p>
      <p class="copy-note">Draft copy — this becomes your real biography after the content interview.</p>
    </div>
  </section>

  <section class="principles section-shell">
    <header>
      <p class="eyebrow">Working principles</p>
      <h2>What the projects already suggest.</h2>
    </header>
    <ol>
      <li>
        <span>01</span>
        <div>
          <h3>Personal scale is real scale.</h3>
          <p>A tool does not need a total addressable market to be worth making.</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <h3>Artifacts beat claims.</h3>
          <p>Show the interface, the game loop, the constraint, and the trade-off.</p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <h3>Keep the user’s data close.</h3>
          <p>Local-first software and visible ownership are product choices, not implementation trivia.</p>
        </div>
      </li>
      <li>
        <span>04</span>
        <div>
          <h3>Delight can carry information.</h3>
          <p>Sound, motion, a study pet, or a good reveal can help the interaction make sense.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="about-details section-shell">
    <div>
      <p class="eyebrow">Interests to confirm</p>
      <ul class="tag-cloud">
        <li>Learning science</li>
        <li>Game systems</li>
        <li>Procedural sound</li>
        <li>Local-first software</li>
        <li>Digital pets</li>
        <li>Visual storytelling</li>
        <li>Vancouver details</li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Currently</p>
      <dl class="status-list">
        <div><dt>Based</dt><dd>{site.location}</dd></div>
        <div><dt>Building</dt><dd>Tools that earn repeat use</dd></div>
        <div><dt>Writing</dt><dd>The first field note</dd></div>
        <div><dt>Open to</dt><dd>Your preferred call to action</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>
