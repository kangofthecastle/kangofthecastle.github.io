---
import '@/styles/global.css';
import { mainNav, site } from '@/data/site';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  pageClass?: string;
};

const {
  title = site.title,
  description = site.description,
  image,
  pageClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? '/og.png', Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/instrument-serif-400-normal.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-noise" aria-hidden="true"></div>

    <header class="site-header" data-site-header>
      <a class="site-mark" href="/" aria-label={`${site.publicName} — home`}>
        <svg class="site-mark__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="site-mark__core" cx="12" cy="12" r="5.5" fill="currentColor" />
          <g class="site-mark__rays" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            {Array.from({ length: 8 }, (_, i) => <path d="M12 1.5v3" transform={`rotate(${i * 45} 12 12)`} />)}
          </g>
        </svg>
        <span class="site-mark__text">{site.publicName}</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        {mainNav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <a class="header-github" href={site.githubUrl} target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <p class="footer-heading">Say hello.</p>
      </div>
      <div class="footer-links">
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        <a href={site.githubUrl} target="_blank" rel="noreferrer">{site.githubLabel} <span aria-hidden="true">↗</span></a>
        <a href={site.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-meta">
        <span>{site.location}</span>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>

    <script>
      import '@/scripts/motion';
      const header = document.querySelector('[data-site-header]');

      const updateHeader = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 24);
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    </script>
  </body>
</html>
