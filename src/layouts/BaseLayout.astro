---
import '@/styles/global.css';
import { mainNav, site } from '@/data/site';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  pageClass?: string;
};

const {
  title = site.title,
  description = site.description,
  image,
  pageClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? '/og.png', Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/instrument-serif-400-normal.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-noise" aria-hidden="true"></div>

    <header class="site-header" data-site-header>
      <a class="site-mark" href="/" aria-label={`${site.publicName} — home`}>
        <svg class="site-mark__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="site-mark__core" cx="12" cy="12" r="5.5" fill="currentColor" />
          <g class="site-mark__rays" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            {Array.from({ length: 8 }, (_, i) => <path d="M12 1.5v3" transform={`rotate(${i * 45} 12 12)`} />)}
          </g>
        </svg>
        <span class="site-mark__text">{site.publicName}</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        {mainNav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <a class="header-github" href={site.githubUrl} target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-contact" data-footer-contact>
        <button class="footer-heading" type="button" aria-expanded="false" aria-controls="footer-contact-links" hidden><svg class="footer-cursor" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 3v17l5-5 4 7 3-1.7-4-7 7-1Z" /></svg><span>Say hello!</span></button>
        <noscript><p class="footer-heading">Say hello!</p></noscript>
        <div class="footer-links" id="footer-contact-links" aria-label="Contact links">
        {site.email && <a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`} title={site.email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
        </a>}
        <a href={site.githubUrl} target="_blank" rel="noreferrer" aria-label={`GitHub ${site.githubLabel}`} title="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.4-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.01-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.09 1.15a10.76 10.76 0 0 1 5.62 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.78 1.16 1.78 1.16 3.01 0 4.33-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
        </a>
        <a href={site.linkedinUrl} target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" /><path d="M7 10v7m4-7v7m0-4a3 3 0 0 1 6 0v4" /><circle cx="7" cy="7" r=".9" fill="currentColor" stroke="none" /></svg>
        </a>
      </div>
      </div>
      <div class="footer-meta">
        <span>{site.location}</span>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>

    <script>
      import '@/scripts/motion';
      const contact = document.querySelector<HTMLElement>('[data-footer-contact]');
      const hello = contact?.querySelector<HTMLButtonElement>('button');
      const links = contact?.querySelector<HTMLElement>('.footer-links');
      if (contact && hello && links) {
        links.inert = true;
        hello.hidden = false;
        contact.classList.add('is-ready');
        let focusTimer: ReturnType<typeof window.setTimeout> | undefined;
        let hideTimer: ReturnType<typeof window.setTimeout> | undefined;
        const reveal = (moveFocus = false) => {
          window.clearTimeout(hideTimer);
          hello.setAttribute('aria-expanded', 'true');
          hello.tabIndex = -1;
          links.inert = false;
          contact.classList.add('is-open');
          if (moveFocus) {
            window.clearTimeout(focusTimer);
            const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 650;
            focusTimer = window.setTimeout(() => {
              if (contact.classList.contains('is-open')) links.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
            }, delay);
          }
        };
        const conceal = () => {
          window.clearTimeout(focusTimer);
          contact.classList.remove('is-open');
          hello.setAttribute('aria-expanded', 'false');
          hello.tabIndex = 0;
          links.inert = true;
        };
        contact.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'touch') reveal();
        });
        contact.addEventListener('pointerleave', () => {
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => {
            if (!contact.contains(document.activeElement)) conceal();
          }, 220);
        });
        hello.addEventListener('focus', () => reveal(true));
        hello.addEventListener('click', () => reveal(true));
        contact.addEventListener('focusout', (event) => {
          if (!contact.contains(event.relatedTarget as Node | null) && !contact.matches(':hover')) conceal();
        });
      }
      const header = document.querySelector('[data-site-header]');

      const updateHeader = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 24);
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    </script>
  </body>
</html>
